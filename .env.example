# AtlasTrader runtime
ATLAS_SYMBOLS=XAUUSD,EURUSD
ATLAS_TIMEFRAME=M5
ATLAS_CANDLE_LOOKBACK=20
ATLAS_INTERVAL_SECONDS=5
ATLAS_INITIAL_BALANCE=0

# Risk controls
ATLAS_TRADING_ENABLED=false
ATLAS_MAX_RISK_PER_TRADE=0.01
ATLAS_MAX_DAILY_LOSS=0.03
ATLAS_MAX_OPEN_POSITIONS=5
ATLAS_MAX_PORTFOLIO_EXPOSURE=0.50
ATLAS_MIN_RISK_REWARD_RATIO=1.5
ATLAS_MAX_SPREAD=5.0

# MetaTrader 5
ATLAS_MT5_LOGIN=
ATLAS_MT5_PASSWORD=
ATLAS_MT5_SERVER=
ATLAS_MT5_PATH=

# Market intelligence
ATLAS_INTELLIGENCE_ENABLED=false
ATLAS_INTELLIGENCE_FINNHUB_API_KEY=
ATLAS_INTELLIGENCE_FINNHUB_BASE_URL=https://finnhub.io/api/v1
ATLAS_INTELLIGENCE_REQUEST_TIMEOUT_SECONDS=10
ATLAS_INTELLIGENCE_MAX_RETRIES=2
ATLAS_INTELLIGENCE_RETRY_BACKOFF_SECONDS=0.5

# Polygon market data
ATLAS_POLYGON_ENABLED=false
ATLAS_POLYGON_API_KEY=
ATLAS_POLYGON_BASE_URL=https://api.polygon.io
ATLAS_POLYGON_REQUEST_TIMEOUT_SECONDS=10
ATLAS_POLYGON_MAX_RETRIES=2
ATLAS_POLYGON_RETRY_BACKOFF_SECONDS=0.5

# Twelve Data market data
ATLAS_TWELVEDATA_ENABLED=false
ATLAS_TWELVEDATA_API_KEY=
ATLAS_TWELVEDATA_BASE_URL=https://api.twelvedata.com
ATLAS_TWELVEDATA_REQUEST_TIMEOUT_SECONDS=10
ATLAS_TWELVEDATA_MAX_RETRIES=2
ATLAS_TWELVEDATA_RETRY_BACKOFF_SECONDS=0.5

