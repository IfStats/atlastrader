ATLAS_MAX_OPEN_POSITIONS=5
ATLAS_MAX_PORTFOLIO_EXPOSURE=0.50
ATLAS_MIN_RISK_REWARD_RATIO=1.5
ATLAS_MAX_SPREAD=5.0

# MetaTrader 5
ATLAS_MT5_LOGIN=
ATLAS_MT5_PASSWORD=
ATLAS_MT5_SERVER=
